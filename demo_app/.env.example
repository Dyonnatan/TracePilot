# Copie para .env (opcional: todos têm valor padrão no docker-compose.yml).

# Credenciais do Postgres do ambiente de referência (apenas local).
POSTGRES_PASSWORD=shop

# Versão do shop-api. `make deploy-bad` / `make deploy-good` sobrescrevem.
SHOP_VERSION=1.0.0

# Portas publicadas no host (somente 127.0.0.1).
SHOP_PORT=8088
CHAOS_PORT=8090

# Tráfego de base do loadgen (requisições por segundo).
LOADGEN_RPS=2
