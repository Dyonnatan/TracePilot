      "panels": [
        {
          "id": "Panel_ID1",
          "type": "line",
          "title": "Resultado dos checkouts (logs)",
          "description": "Eventos de checkout por tipo. Sucesso cai e um tipo de falha sobe quando um cenário está ativo.",
          "config": {
            "show_legends": true,
            "legends_position": null,
            "decimals": 0,
            "unit": null
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS x_axis_1, event_type AS breakdown_1, count(*) AS y_axis_1 FROM \"default\" WHERE event_type IN ('checkout.success', 'payment.timeout', 'payment.unavailable', 'payment.error', 'db.unavailable', 'unhandled.error') GROUP BY x_axis_1, breakdown_1 ORDER BY x_axis_1",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Tempo",
                    "alias": "x_axis_1",
                    "column": "x_axis_1",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Eventos",
                    "alias": "y_axis_1",
                    "column": "y_axis_1",
                    "color": "#5960b2"
                  }
                ],
                "z": [],
                "breakdown": [
                  {
                    "label": "Série",
                    "alias": "breakdown_1",
                    "column": "breakdown_1",
                    "color": null
                  }
                ],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1,
                "limit": 0,
                "min": 0,
                "max": 100
              }
            }
          ],
          "layout": {
            "x": 0,
            "y": 0,
            "w": 192,
            "h": 18,
            "i": 1
          },
          "htmlContent": "",
          "markdownContent": ""
