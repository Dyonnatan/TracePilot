        {
          "id": "Panel_ID2",
          "type": "line",
          "title": "Pagamento: visão do cliente x visão do servidor (ms)",
          "description": "Span cliente do shop-api (POST) contra span servidor do payment-service (POST /authorize). Distância grande entre as duas linhas = tempo perdido na rede.",
          "config": {
            "show_legends": true,
            "legends_position": null,
            "decimals": 0,
            "unit": null
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS x_axis_1, service_name AS breakdown_1, avg(duration) / 1000 AS y_axis_1 FROM \"default\" WHERE (service_name = 'shop-api' AND operation_name = 'POST') OR (service_name = 'payment-service' AND operation_name = 'POST /authorize') GROUP BY x_axis_1, breakdown_1 ORDER BY x_axis_1",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [
                  {
                    "label": "Tempo",
                    "alias": "x_axis_1",
                    "column": "x_axis_1",
                    "color": null
                  }
                ],
                "y": [
                  {
                    "label": "Duração média (ms)",
                    "alias": "y_axis_1",
                    "column": "y_axis_1",
                    "color": "#5960b2"
                  }
                ],
                "z": [],
                "breakdown": [
                  {
                    "label": "Série",
                    "alias": "breakdown_1",
                    "column": "breakdown_1",
                    "color": null
                  }
                ],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
