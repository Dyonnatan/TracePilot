# Backend de LLM usado pelos agentes: "cloud" ou "local"
LLM_BACKEND=local

# --- Provider local / open-weight via Ollama (usado quando LLM_BACKEND=local) ---
# Pensado para GPU de entrada (ex.: 4GB de VRAM, como a GTX 1650): modelos
# na faixa de 3-4B cabem inteiros na GPU. Trocar é só mudar este valor +
# `ollama pull <modelo>` — não precisa mexer em código.
#
# Opções testadas para comparar qualidade na mesma falha do demo_app:
#   - gemma3:4b                         → propósito geral, ~3.3GB, bom em seguir instrução sem inventar
#   - hf.co/BrainboxAI/cyber-analyst-4B → fine-tune de segurança, mesmo porte, foco em análise de incidente
#   - llama3.2:3b                       → mais leve/rápido, fallback se os acima forem lentos demais
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- Provider cloud via OpenRouter (usado quando LLM_BACKEND=cloud) ---
# Catálogo de modelos: https://openrouter.ai/models
# Comece com um modelo pequeno/barato para validar o pipeline; depois troque
# só este valor para um modelo mais avançado (não precisa mudar código).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://github.com/Dyonnatan/TracePilot

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=tracepilot

# --- OpenObserve ---
OPENOBSERVE_URL=http://localhost:5080
OPENOBSERVE_ORG=default
# Para dev local via docker-compose.yml, use usuário/senha (bate com
# ZO_ROOT_USER_EMAIL/PASSWORD definidos lá). Em produção, prefira um token.
OPENOBSERVE_TOKEN=
OPENOBSERVE_USER=admin@tracepilot.local
OPENOBSERVE_PASSWORD=ChangeMe123!

# --- API de ingestão direta (ingest/) ---
# Caminho sem instalador: a aplicação monitorada manda log/span direto.
# Ver docs/ingestion-modes.md e docs/ai-integration-guide.md.
# Endpoint OTLP/HTTP do collector para onde a API repassa os eventos.
TRACEPILOT_OTLP_HTTP_ENDPOINT=http://localhost:4318
# Chaves aceitas, separadas por vírgula (uma por serviço/cliente integrado).
# Vazio = API aberta — só para desenvolvimento local, nunca em produção.
TRACEPILOT_INGEST_KEYS=
TRACEPILOT_INGEST_MAX_EVENTS=500

# --- Painel web (webapp/) ---
# Preset de demonstração: pré-preenche a jornada de onboarding (arquivo em
# webapp/presets/<nome>.json). Padrão: reference-environment — a loja Apex
# Space da branch feat/reference-environment (shop-api em localhost:8088).
# Use "none" para formulários vazios.
TRACEPILOT_PRESET=reference-environment
# Fallbacks quando o onboarding não informou URL/serviço do sistema monitorado.
DEMO_APP_URL=http://localhost:8099
MONITORED_SERVICE_NAME=tracepilot-demo-app
# Opcional: token para analisar repositório privado no passo "Repositório".
GITHUB_TOKEN=
# Segredo que assina o cookie de sessão. Vazio = gerado uma vez em
# workspace/secret.key.
TRACEPILOT_SECRET=
