# Backend de LLM usado pelos agentes: "cloud" ou "local"
LLM_BACKEND=cloud

# --- Provider cloud (usado quando LLM_BACKEND=cloud) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLOUD_MODEL=claude-sonnet-5

# --- Provider local / open-weight (usado quando LLM_BACKEND=local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Observabilidade ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=tracepilot

# --- OpenObserve ---
OPENOBSERVE_URL=http://localhost:5080
OPENOBSERVE_ORG=default
OPENOBSERVE_TOKEN=
